class Solution {
    public List<Integer> frequencyCount(int[] arr) {
        // code here
        int n =arr.length;
        int freq[] = new int[n];
        
        for(int i=0; i<n; i++){
            int key = arr[i];
            
            if(key >= 1 && key <= n){
                freq[key-1]++;
            }
        }
        
        ArrayList<Integer> result = new ArrayList<>();
        for(int val : freq){
            result.add(val);
        }
        return result;
    }
}
